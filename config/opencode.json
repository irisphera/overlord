{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [],
  "lsp": true,
  "permission": {
    "lsp": "allow"
  },
  "provider": {
    "google-vertex": {
      "npm": "@ai-sdk/google-vertex",
      "name": "Google Vertex AI",
      "options": {
        "project": "{env:GOOGLE_CLOUD_PROJECT}",
        "location": "global"
      },
      "models": {
        "gemini-3.5-flash": {
          "name": "Gemini 3.5 Flash",
          "tool_call": true
        }
      }
    },
    "azure": {
      "npm": "@ai-sdk/azure",
      "name": "Azure OpenAI",
      "env": [
        "AZURE_API_KEY"
      ],
      "models": {
        "gpt-5.6-sol": {
          "name": "GPT-5.6 Sol",
          "id": "gpt-5.6-sol",
          "options": {
            "serviceTier": "priority"
          },
          "reasoning": true,
          "tool_call": true,
          "attachment": true,
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "limit": {
            "context": 272000,
            "input": 272000,
            "output": 128000
          }
        },
        "gpt-5.6-luna": {
          "name": "GPT-5.6 Luna",
          "id": "gpt-5.6-luna",
          "reasoning": true,
          "tool_call": true,
          "attachment": true,
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "limit": {
            "context": 272000,
            "input": 272000,
            "output": 128000
          }
        }
      }
    },
    "openrouter": {
      "models": {
        "poolside/laguna-s-2.1:free": {
          "name": "poolside/laguna-s-2.1:free",
          "reasoning": true,
          "tool_call": true,
          "modalities": {
            "input": [
              "text"
            ],
            "output": [
              "text"
            ]
          },
          "limit": {
            "context": 262144,
            "output": 32768
          }
        }
      }
    },
    "lmstudio": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LM Studio",
      "options": {
        "baseURL": "{env:LMSTUDIO_BASE_URL}",
        "apiKey": "{env:LMSTUDIO_API_KEY}"
      },
      "models": {
        "qwopus3.5-9b-coder-mtp": {
          "name": "qwopus3.5-9b-coder-mtp"
        }
      }
    }
  }
}
