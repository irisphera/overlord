{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-openagent/dev/assets/oh-my-opencode.schema.json",
  "sisyphus_agent": {
    "planner_enabled": true,
    "replace_plan": true
  },
  "background_task": {
    "providerConcurrency": {
      "openrouter": 1
    }
  },
  "team_mode": {
    "enabled": true,
    "max_parallel_members": 1
  },
  "codegraph": {
    "enabled": true,
    "auto_provision": true,
    "telemetry": false
  },
  "categories": {
    // Ling uses OpenRouter's default reasoning behavior for every category.
    "ultrabrain": {
      "model": "openrouter/inclusionai/ling-3.0-flash:free"
    },
    "unspecified-high": {
      "model": "openrouter/inclusionai/ling-3.0-flash:free"
    },
    "visual-engineering": {
      "model": "openrouter/inclusionai/ling-3.0-flash:free"
    },
    "artistry": {
      "model": "openrouter/inclusionai/ling-3.0-flash:free"
    },
    "writing": {
      "model": "openrouter/inclusionai/ling-3.0-flash:free"
    },
    "quick": {
      "model": "openrouter/inclusionai/ling-3.0-flash:free"
    },
    "unspecified-low": {
      "model": "openrouter/inclusionai/ling-3.0-flash:free"
    }
  },
  "agents": {
    // Ling uses OpenRouter's default reasoning behavior for every agent.
    "sisyphus": {
      "model": "openrouter/inclusionai/ling-3.0-flash:free",
      
    },
    "atlas": {
      "model": "openrouter/inclusionai/ling-3.0-flash:free",
      
    },
    "oracle": {
      "model": "openrouter/inclusionai/ling-3.0-flash:free",
      
    },
    "prometheus": {
      "model": "openrouter/inclusionai/ling-3.0-flash:free",
      
    },
    "hephaestus": {
      "model": "openrouter/inclusionai/ling-3.0-flash:free",
      
    },
    "plan": {
      "model": "openrouter/inclusionai/ling-3.0-flash:free",
      
    },
    "sisyphus-junior": {
      "model": "openrouter/inclusionai/ling-3.0-flash:free",
      
    },
    "OpenCode-Builder": {
      "model": "openrouter/inclusionai/ling-3.0-flash:free",
      
    },
    "build": {
      "model": "openrouter/inclusionai/ling-3.0-flash:free",
      
    },
    "metis": {
      "model": "openrouter/inclusionai/ling-3.0-flash:free",
      
    },
    "momus": {
      "model": "openrouter/inclusionai/ling-3.0-flash:free",
      
    },
    "multimodal-looker": {
      "model": "openrouter/inclusionai/ling-3.0-flash:free",
      
    },
    "explore": {
      "model": "openrouter/inclusionai/ling-3.0-flash:free",
      "category": "unspecified-low",
      
    },
    "librarian": {
      "model": "openrouter/inclusionai/ling-3.0-flash:free",
      "category": "unspecified-low",
      
    }
  }
}
