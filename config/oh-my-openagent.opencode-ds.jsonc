{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-openagent/dev/assets/oh-my-opencode.schema.json",
  "sisyphus_agent": {
    "planner_enabled": true,
    "replace_plan": true
  },
  "team_mode": {
    "enabled": true
  },
  "codegraph": {
    "enabled": true,
    "auto_provision": true,
    "telemetry": false
  },
  "categories": {
    // DeepSeek-V4-Flash-0731 routes through the built-in opencode-go provider.
    // Categories use the canonical `reasoning` field; it is lowered to the
    // deepseek variant/reasoning effort for delegated tasks.
    "ultrabrain": {
      "model": "opencode-go/deepseek-v4-flash",
      "reasoning": "max"
    },
    "unspecified-high": {
      "model": "opencode-go/deepseek-v4-flash",
      "reasoning": "max"
    },
    "visual-engineering": {
      "model": "opencode-go/deepseek-v4-flash",
      "reasoning": "max"
    },
    "artistry": {
      "model": "opencode-go/deepseek-v4-flash",
      "reasoning": "max"
    },
    "writing": {
      "model": "opencode-go/deepseek-v4-flash",
      "reasoning": "max"
    },
    "quick": {
      "model": "opencode-go/deepseek-v4-flash"
    },
    "unspecified-low": {
      "model": "opencode-go/deepseek-v4-flash"
    }
  },
  "agents": {
    // Agents use the OpenCode-native `variant` key, which is the only per-agent
    // selector that survives the full request path for opencode-go/deepseek-v4-flash
    // (the model declares reasoning effort variants "high" and "max").
    "sisyphus": {
      "model": "opencode-go/deepseek-v4-flash",
      "variant": "max"
    },
    "atlas": {
      "model": "opencode-go/deepseek-v4-flash",
      "variant": "max"
    },
    "oracle": {
      "model": "opencode-go/deepseek-v4-flash",
      "variant": "max"
    },
    "prometheus": {
      "model": "opencode-go/deepseek-v4-flash",
      "variant": "max"
    },
    "hephaestus": {
      "model": "opencode-go/deepseek-v4-flash",
      "variant": "max"
    },
    "plan": {
      "model": "opencode-go/deepseek-v4-flash",
      "variant": "max"
    },
    "sisyphus-junior": {
      "model": "opencode-go/deepseek-v4-flash",
      "variant": "max"
    },
    "OpenCode-Builder": {
      "model": "opencode-go/deepseek-v4-flash",
      "variant": "max"
    },
    "build": {
      "model": "opencode-go/deepseek-v4-flash",
      "variant": "max"
    },
    "metis": {
      "model": "opencode-go/deepseek-v4-flash",
      "variant": "max"
    },
    "momus": {
      "model": "opencode-go/deepseek-v4-flash",
      "variant": "max"
    },
    "multimodal-looker": {
      "model": "opencode-go/deepseek-v4-flash"
    },
    "explore": {
      "model": "opencode-go/deepseek-v4-flash",
      "category": "unspecified-low"
    },
    "librarian": {
      "model": "opencode-go/deepseek-v4-flash",
      "category": "unspecified-high"
    }
  }
}
