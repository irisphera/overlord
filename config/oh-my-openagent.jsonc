{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-openagent/dev/assets/oh-my-opencode.schema.json",
  "sisyphus_agent": {
    "planner_enabled": true,
    "replace_plan": true
  },
  "team_mode": {
    "enabled": true
  },
  "codegraph": {
    "enabled": true,
    "auto_provision": true,
    "telemetry": false
  },
  "categories": {
    // HIGH reasoning — all categories use high effort
    "ultrabrain": {
      "model": "amazon-bedrock/anthropic.claude-opus-4-5-20251101-v1:0",
      "reasoningEffort": "high"
    },
    "unspecified-high": {
      "model": "amazon-bedrock/anthropic.claude-opus-4-5-20251101-v1:0",
      "reasoningEffort": "high"
    },
    // HIGH reasoning — creative, visual, and writing tasks
    "visual-engineering": {
      "model": "amazon-bedrock/anthropic.claude-opus-4-5-20251101-v1:0",
      "reasoningEffort": "high"
    },
    "artistry": {
      "model": "amazon-bedrock/anthropic.claude-opus-4-5-20251101-v1:0",
      "reasoningEffort": "high"
    },
    "writing": {
      "model": "amazon-bedrock/anthropic.claude-opus-4-5-20251101-v1:0",
      "reasoningEffort": "high"
    },
    // HIGH reasoning — quick and unspecified-low tasks
    "quick": {
      "model": "amazon-bedrock/anthropic.claude-opus-4-5-20251101-v1:0",
      "reasoningEffort": "high"
    },
    "unspecified-low": {
      "model": "amazon-bedrock/anthropic.claude-opus-4-5-20251101-v1:0",
      "reasoningEffort": "high"
    }
  },
  "agents": {
    // HIGH reasoning — all agents except explore
    "sisyphus": {
      "model": "amazon-bedrock/anthropic.claude-opus-4-5-20251101-v1:0",
      "reasoningEffort": "high",
      
    },
    "atlas": {
      "model": "amazon-bedrock/anthropic.claude-opus-4-5-20251101-v1:0",
      "reasoningEffort": "high",
      
    },
    "oracle": {
      "model": "amazon-bedrock/anthropic.claude-opus-4-5-20251101-v1:0",
      "reasoningEffort": "high",
      
    },
    "prometheus": {
      "model": "amazon-bedrock/anthropic.claude-opus-4-5-20251101-v1:0",
      "reasoningEffort": "high",
      
    },
    "hephaestus": {
      "model": "amazon-bedrock/anthropic.claude-opus-4-5-20251101-v1:0",
      "reasoningEffort": "high",
      
    },
    "plan": {
      "model": "amazon-bedrock/anthropic.claude-opus-4-5-20251101-v1:0",
      "reasoningEffort": "high",
      
    },
    // HIGH reasoning — validation, building, and general work
    "sisyphus-junior": {
      "model": "amazon-bedrock/anthropic.claude-opus-4-5-20251101-v1:0",
      "reasoningEffort": "high",
      
    },
    "OpenCode-Builder": {
      "model": "amazon-bedrock/anthropic.claude-opus-4-5-20251101-v1:0",
      "reasoningEffort": "high",
      
    },
    "build": {
      "model": "amazon-bedrock/anthropic.claude-opus-4-5-20251101-v1:0",
      "reasoningEffort": "high",
      
    },
    "metis": {
      "model": "amazon-bedrock/anthropic.claude-opus-4-5-20251101-v1:0",
      "reasoningEffort": "high",
      
    },
    "momus": {
      "model": "amazon-bedrock/anthropic.claude-opus-4-5-20251101-v1:0",
      "reasoningEffort": "high",
      
    },
    "multimodal-looker": {
      "model": "amazon-bedrock/anthropic.claude-opus-4-5-20251101-v1:0",
      "reasoningEffort": "high",
      
    },
    // LOW reasoning — exploration only
    "explore": {
      "model": "amazon-bedrock/anthropic.claude-opus-4-5-20251101-v1:0",
      "reasoningEffort": "low",
      "category": "unspecified-low",
      
    },
    "librarian": {
      "model": "amazon-bedrock/anthropic.claude-opus-4-5-20251101-v1:0",
      "reasoningEffort": "high",
      "category": "unspecified-low",
      
    }
  }
}
