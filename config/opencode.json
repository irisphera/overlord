{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [],
  "lsp": true,
  "permission": {
    "lsp": "allow"
  },
  "provider": {
    "google": {
      "npm": "@ai-sdk/google-vertex",
      "name": "Google Vertex AI",
      "options": {
        "project": "{env:GOOGLE_CLOUD_PROJECT}",
        "location": "{env:GOOGLE_CLOUD_LOCATION}"
      },
      "models": {
        "gemini-3.6-flash": {
          "name": "Gemini 3.6 Flash",
          "id": "gemini-3.6-flash",
          "tool_call": true,
          "limit": {
            "context": 128000,
            "output": 65536
          }
        }
      }
    },
    "amazon-bedrock": {
      "npm": "@ai-sdk/amazon-bedrock",
      "name": "Amazon Bedrock",
      "models": {
        "anthropic.claude-opus-4-5-20251101-v1:0": {
          "name": "Claude Opus 4.5",
          "id": "anthropic.claude-opus-4-5-20251101-v1:0",
          "reasoning": true,
          "tool_call": true,
          "limit": {
            "context": 100000,
            "output": 64000
          }
        }
      }
    },
    "azure": {
      "npm": "@ai-sdk/azure",
      "name": "Azure OpenAI",
      "env": [
        "AZURE_API_KEY"
      ],
      "models": {
        "gpt-5.6-sol": {
          "name": "GPT-5.6 Sol",
          "id": "gpt-5.6-sol",
          "options": {
            "serviceTier": "priority"
          },
          "reasoning": true,
          "tool_call": true,
          "attachment": true,
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "limit": {
            "context": 272000,
            "input": 272000,
            "output": 128000
          }
        },
        "gpt-5.6-luna": {
          "name": "GPT-5.6 Luna",
          "id": "gpt-5.6-luna",
          "reasoning": true,
          "tool_call": true,
          "attachment": true,
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "limit": {
            "context": 272000,
            "input": 272000,
            "output": 128000
          }
        }
      }
    },
    "openrouter": {
      "models": {
        "poolside/laguna-s-2.1:free": {
          "name": "poolside/laguna-s-2.1:free",
          "reasoning": true,
          "tool_call": true,
          "modalities": {
            "input": [
              "text"
            ],
            "output": [
              "text"
            ]
          },
          "limit": {
            "context": 262144,
            "output": 32768
          }
        }
      }
    }
  }
}
